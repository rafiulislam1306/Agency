{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Signal Precision Design System v2026.1 — 80/20 Light-First Hybrid for B2B Google Ads, GBP Optimization & GA4/Server-Side GTM Agencies",
  "color": {
    "primitive": {
      "neutral": {
        "0":   { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff" } },
        "50":  { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9725, 0.9804, 0.9882], "hex": "#f8fafc" } },
        "100": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9608, 0.9765], "hex": "#f1f5f9" } },
        "200": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.8863, 0.9098, 0.9412], "hex": "#e2e8f0" } },
        "300": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.7961, 0.8353, 0.8824], "hex": "#cbd5e1" } },
        "400": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.5804, 0.6392, 0.7216], "hex": "#94a3b8" } },
        "500": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.3922, 0.4549, 0.5451], "hex": "#64748b" } },
        "600": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.2784, 0.3333, 0.4118], "hex": "#475569" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.2, 0.2549, 0.3333], "hex": "#334155" } },
        "800": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1176, 0.1608, 0.2314], "hex": "#1e293b" } },
        "900": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "hex": "#0f172a" } }
      },
      "midnight": {
        "950": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.0431, 0.0667, 0.1255], "hex": "#0b1120" } },
        "900": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.0667, 0.1098, 0.2], "hex": "#111c33" } },
        "800": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.102, 0.1529, 0.2667], "hex": "#1a2744" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.149, 0.2078, 0.3294], "hex": "#263554" } }
      },
      "cobalt": {
        "50":  { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9373, 0.9647, 1.0], "hex": "#eff6ff" } },
        "100": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.8588, 0.9176, 0.9961], "hex": "#dbeafe" } },
        "300": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.5765, 0.7725, 0.9922], "hex": "#93c5fd" } },
        "400": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.3765, 0.6471, 0.9804], "hex": "#60a5fa" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8" } },
        "800": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1176, 0.251, 0.6863], "hex": "#1e40af" } },
        "900": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1176, 0.2275, 0.5412], "hex": "#1e3a8a" } }
      },
      "vermilion": {
        "50":  { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1.0, 0.9686, 0.9294], "hex": "#fff7ed" } },
        "400": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9843, 0.5725, 0.2353], "hex": "#fb923c" } },
        "500": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9765, 0.451, 0.0863], "hex": "#f97316" } },
        "600": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9176, 0.3451, 0.0471], "hex": "#ea580c" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.7294, 0.2275, 0.0353], "hex": "#ba3a09" }, "$description": "WCAG AA + Deuteranopia-safe light CTA fill (5.68:1 normal, 4.91:1 deut w/ white)" },
        "800": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.6039, 0.2039, 0.0706], "hex": "#9a3412" } },
        "900": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.4863, 0.1765, 0.0706], "hex": "#7c2d12" } }
      },
      "teal": {
        "50":  { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9412, 0.9922, 0.9804], "hex": "#f0fdfa" } },
        "400": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1765, 0.8314, 0.749], "hex": "#2dd4bf" } },
        "600": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.051, 0.5804, 0.5333], "hex": "#0d9488" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.0588, 0.4627, 0.4314], "hex": "#0f766e" } }
      },
      "crimson": {
        "50":  { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9961, 0.949, 0.949], "hex": "#fef2f2" } },
        "400": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9725, 0.4431, 0.4431], "hex": "#f87171" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c" } }
      },
      "amber": {
        "50":  { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1.0, 0.9843, 0.9216], "hex": "#fffbeb" } },
        "400": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.9843, 0.749, 0.1412], "hex": "#fbbf24" } },
        "700": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.7059, 0.3255, 0.0353], "hex": "#b45309" } }
      },
      "sky": {
        "400": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.2196, 0.7412, 0.9725], "hex": "#38bdf8" } }
      }
    },
    "semantic": {
      "light": {
        "canvas":             { "$type": "color", "$value": "{color.primitive.neutral.50}" },
        "surface-card":       { "$type": "color", "$value": "{color.primitive.neutral.0}" },
        "surface-subtle":     { "$type": "color", "$value": "{color.primitive.neutral.100}" },
        "text-primary":       { "$type": "color", "$value": "{color.primitive.neutral.900}" },
        "text-secondary":     { "$type": "color", "$value": "{color.primitive.neutral.700}" },
        "text-muted":         { "$type": "color", "$value": "{color.primitive.neutral.600}" },
        "border-decorative":  { "$type": "color", "$value": "{color.primitive.neutral.200}" },
        "border-strong":      { "$type": "color", "$value": "{color.primitive.neutral.300}" },
        "border-interactive": { "$type": "color", "$value": "{color.primitive.neutral.500}", "$description": "SC 1.4.11 >= 3.0:1 boundary for inputs and outline buttons" },
        "brand-trust":        { "$type": "color", "$value": "{color.primitive.cobalt.700}" },
        "brand-trust-hover":  { "$type": "color", "$value": "{color.primitive.cobalt.800}" },
        "brand-trust-tint":   { "$type": "color", "$value": "{color.primitive.cobalt.50}" },
        "cta-bg":             { "$type": "color", "$value": "{color.primitive.vermilion.700}" },
        "cta-bg-hover":       { "$type": "color", "$value": "{color.primitive.vermilion.800}" },
        "cta-bg-active":      { "$type": "color", "$value": "{color.primitive.vermilion.900}" },
        "cta-text":           { "$type": "color", "$value": "{color.primitive.neutral.0}" },
        "cta-tint":           { "$type": "color", "$value": "{color.primitive.vermilion.50}" },
        "focus-ring":         { "$type": "color", "$value": "{color.primitive.cobalt.700}" },
        "status-positive":    { "$type": "color", "$value": "{color.primitive.teal.700}" },
        "status-positive-bg": { "$type": "color", "$value": "{color.primitive.teal.50}" },
        "status-negative":    { "$type": "color", "$value": "{color.primitive.crimson.700}" },
        "status-negative-bg": { "$type": "color", "$value": "{color.primitive.crimson.50}" },
        "status-warning":     { "$type": "color", "$value": "{color.primitive.amber.700}" },
        "status-warning-bg":  { "$type": "color", "$value": "{color.primitive.amber.50}" },
        "disabled-bg":        { "$type": "color", "$value": "{color.primitive.neutral.200}" },
        "disabled-text":      { "$type": "color", "$value": "{color.primitive.neutral.600}" }
      },
      "dark": {
        "$description": "Applied to 20% dark technical proof bands (sGTM/GA4 pipelines, code wells, closing conversion anchor) and optional user-selected dark theme",
        "canvas":             { "$type": "color", "$value": "{color.primitive.midnight.950}" },
        "surface-card":       { "$type": "color", "$value": "{color.primitive.midnight.900}" },
        "surface-elevated":   { "$type": "color", "$value": "{color.primitive.midnight.800}" },
        "text-primary":       { "$type": "color", "$value": "{color.primitive.neutral.50}" },
        "text-secondary":     { "$type": "color", "$value": "{color.primitive.neutral.300}" },
        "text-muted":         { "$type": "color", "$value": "{color.primitive.neutral.400}" },
        "border-decorative":  { "$type": "color", "$value": "{color.primitive.midnight.700}" },
        "border-interactive": { "$type": "color", "$value": "{color.primitive.neutral.500}" },
        "brand-trust":        { "$type": "color", "$value": "{color.primitive.cobalt.400}" },
        "brand-trust-hover":  { "$type": "color", "$value": "{color.primitive.cobalt.300}" },
        "cta-bg":             { "$type": "color", "$value": "{color.primitive.vermilion.500}" },
        "cta-bg-hover":       { "$type": "color", "$value": "{color.primitive.vermilion.400}" },
        "cta-bg-active":      { "$type": "color", "$value": "{color.primitive.vermilion.600}" },
        "cta-text":           { "$type": "color", "$value": "{color.primitive.midnight.950}" },
        "focus-ring":         { "$type": "color", "$value": "{color.primitive.cobalt.400}" },
        "status-positive":    { "$type": "color", "$value": "{color.primitive.teal.400}" },
        "status-negative":    { "$type": "color", "$value": "{color.primitive.crimson.400}" },
        "status-warning":     { "$type": "color", "$value": "{color.primitive.amber.400}" },
        "status-info":        { "$type": "color", "$value": "{color.primitive.sky.400}" },
        "disabled-bg":        { "$type": "color", "$value": "{color.primitive.neutral.800}" },
        "disabled-text":      { "$type": "color", "$value": "{color.primitive.neutral.400}" }
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$description": "Generate dedicated Plus Jakarta metric fallback via next/font or fontaine; falls back to Inter Fallback otherwise",
        "$value": ["Plus Jakarta Sans Variable", "Plus Jakarta Sans", "Inter Fallback", "system-ui", "sans-serif"]
      },
      "body": { "$type": "fontFamily", "$value": ["Inter Variable", "Inter", "Inter Fallback", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono Variable", "JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "display-hero-desktop": {
      "$type": "typography",
      "$description": "Desktop endpoint (56px, -0.03em tracking = -0.105rem); use fluid clamp() from tokens.css in web builds",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": { "value": 3.5, "unit": "rem" },
        "fontWeight": "{font.weight.bold}",
        "lineHeight": 1.08,
        "letterSpacing": { "value": -0.105, "unit": "rem" }
      }
    },
    "display-hero-mobile": {
      "$type": "typography",
      "$description": "Mobile endpoint (36px, -0.03em tracking = -0.0675rem)",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": { "value": 2.25, "unit": "rem" },
        "fontWeight": "{font.weight.bold}",
        "lineHeight": 1.08,
        "letterSpacing": { "value": -0.0675, "unit": "rem" }
      }
    },
    "heading-h2-desktop": {
      "$type": "typography",
      "$description": "Desktop endpoint (40px, -0.025em tracking = -0.0625rem)",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": { "value": 2.5, "unit": "rem" },
        "fontWeight": "{font.weight.bold}",
        "lineHeight": 1.15,
        "letterSpacing": { "value": -0.0625, "unit": "rem" }
      }
    },
    "heading-h3-desktop": {
      "$type": "typography",
      "$description": "Desktop endpoint (28px, -0.02em tracking = -0.035rem)",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": { "value": 1.75, "unit": "rem" },
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.25,
        "letterSpacing": { "value": -0.035, "unit": "rem" }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": { "value": 1, "unit": "rem" },
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.6,
        "letterSpacing": { "value": 0, "unit": "rem" }
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": { "value": 0.875, "unit": "rem" },
        "fontWeight": "{font.weight.regular}",
        "lineHeight": 1.5,
        "letterSpacing": { "value": 0, "unit": "rem" }
      }
    },
    "kpi-hero-desktop": {
      "$type": "typography",
      "$description": "Desktop endpoint (52px, -0.03em = -0.0975rem); apply font-variant-numeric: tabular-nums lining-nums",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": { "value": 3.25, "unit": "rem" },
        "fontWeight": "{font.weight.bold}",
        "lineHeight": 1.05,
        "letterSpacing": { "value": -0.0975, "unit": "rem" }
      }
    },
    "kpi-card-desktop": {
      "$type": "typography",
      "$description": "Desktop endpoint (32px, -0.02em = -0.04rem); apply font-variant-numeric: tabular-nums slashed-zero",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": { "value": 2, "unit": "rem" },
        "fontWeight": "{font.weight.bold}",
        "lineHeight": 1.15,
        "letterSpacing": { "value": -0.04, "unit": "rem" }
      }
    },
    "label-eyebrow": {
      "$type": "typography",
      "$description": "12px uppercase spec eyebrow (0.08em tracking = 0.06rem)",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": { "value": 0.75, "unit": "rem" },
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.33,
        "letterSpacing": { "value": 0.06, "unit": "rem" }
      }
    }
  },
  "spacing": {
    "1":  { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2":  { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3":  { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4":  { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6":  { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8":  { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
    "24": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } },
    "32": { "$type": "dimension", "$value": { "value": 128, "unit": "px" } },
    "container-max": { "$type": "dimension", "$value": { "value": 1280, "unit": "px" } }
  },
  "radius": {
    "xs":   { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "sm":   { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
    "md":   { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "lg":   { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "xl":   { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "2xl":  { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "full": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
  },
  "border": {
    "light-hairline": {
      "$type": "border",
      "$value": { "color": "{color.semantic.light.border-decorative}", "width": { "value": 1, "unit": "px" }, "style": "solid" }
    },
    "light-interactive": {
      "$type": "border",
      "$value": { "color": "{color.semantic.light.border-interactive}", "width": { "value": 1, "unit": "px" }, "style": "solid" }
    },
    "dark-hairline": {
      "$type": "border",
      "$value": { "color": "{color.semantic.dark.border-decorative}", "width": { "value": 1, "unit": "px" }, "style": "solid" }
    },
    "focus-ring-light": {
      "$type": "border",
      "$value": { "color": "{color.semantic.light.focus-ring}", "width": { "value": 2, "unit": "px" }, "style": "solid" }
    }
  },
  "shadow": {
    "light-level-1": {
      "$type": "shadow",
      "$description": "3-layer Ring + Contact + Ambient micro-shadow for interactive light cards",
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "alpha": 0.06, "hex": "#0f172a" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 1, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "alpha": 0.06, "hex": "#0f172a" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": -1, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "alpha": 0.04, "hex": "#0f172a" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 4, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      ]
    },
    "light-level-2": {
      "$type": "shadow",
      "$description": "Floating elevation for dropdowns, sticky nav, modals, and dashboard mockups",
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "alpha": 0.06, "hex": "#0f172a" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 1, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "alpha": 0.08, "hex": "#0f172a" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 8, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": -4, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "alpha": 0.04, "hex": "#0f172a" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 6, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      ]
    },
    "dark-specular-edge": {
      "$type": "shadow",
      "$description": "Top-edge white inset highlight for lifted cards inside #0B1120 dark proof bands",
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "alpha": 0.06, "hex": "#ffffff" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "inset": true },
        { "color": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "alpha": 0.04, "hex": "#ffffff" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 1, "unit": "px" }, "inset": true }
      ]
    }
  },
  "component": {
    "button-primary": {
      "min-height":     { "$type": "dimension", "$value": { "value": 44, "unit": "px" } },
      "hero-height":    { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
      "padding-x":      { "$type": "dimension", "$value": "{spacing.6}" },
      "radius":         { "$type": "dimension", "$value": "{radius.md}" },
      "bg-light":       { "$type": "color", "$value": "{color.semantic.light.cta-bg}" },
      "bg-light-hover": { "$type": "color", "$value": "{color.semantic.light.cta-bg-hover}" },
      "text-light":     { "$type": "color", "$value": "{color.semantic.light.cta-text}" },
      "bg-dark":        { "$type": "color", "$value": "{color.semantic.dark.cta-bg}" },
      "text-dark":      { "$type": "color", "$value": "{color.semantic.dark.cta-text}" }
    },
    "card-bento": {
      "padding":        { "$type": "dimension", "$value": "{spacing.6}" },
      "padding-lg":     { "$type": "dimension", "$value": "{spacing.8}" },
      "radius-outer":   { "$type": "dimension", "$value": "{radius.xl}" },
      "frame-bezel":    { "$type": "dimension", "$value": "{spacing.2}" },
      "radius-inner":   { "$type": "dimension", "$value": "{radius.md}" }
    },
    "input-field": {
      "min-height":     { "$type": "dimension", "$value": { "value": 44, "unit": "px" } },
      "padding-x":      { "$type": "dimension", "$value": "{spacing.3}" },
      "radius":         { "$type": "dimension", "$value": "{radius.sm}" },
      "border-light":   { "$type": "border", "$value": "{border.light-interactive}" }
    }
  }
}
